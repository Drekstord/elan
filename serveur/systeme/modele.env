# =====================================================================
# ÉLAN : réglages du serveur
#
# Ne pas remplir à la main : lancer « Préparer le serveur » (Windows) ou
#   sh systeme/preparer.sh http://ADRESSE-DU-NAS:8000
# qui crée le fichier .env (à côté de docker-compose.yml) à partir de ce modèle, avec des secrets neufs.
#
# Le fichier .env contient les clés du serveur : ne jamais le partager.
# =====================================================================

# Adresse du serveur vue depuis le téléphone (VPN ou réseau local), sans / final.
ADRESSE_SERVEUR=http://192.168.1.20:8000
# Port ouvert sur le NAS (doit correspondre à l'adresse ci-dessus).
PORT=8000

# Tableau de bord (http://ADRESSE-DU-NAS:8000 dans un navigateur).
DASHBOARD_USERNAME=elan
DASHBOARD_PASSWORD=A_GENERER

# Sauvegarde automatique de la base (./donnees/sauvegardes).
HEURE_SAUVEGARDE=03:00
SAUVEGARDES_A_GARDER=14
TZ=Europe/Paris

# ---- Secrets (générés, ne plus modifier une fois le serveur lancé) ----
POSTGRES_PASSWORD=A_GENERER
JWT_SECRET=A_GENERER
# Clé publique : c'est elle qu'on saisit dans l'app ÉLAN.
ANON_KEY=A_GENERER
# Clé de service : accès total, réservée au tableau de bord. Ne jamais la mettre dans l'app.
SERVICE_ROLE_KEY=A_GENERER
PG_META_CRYPTO_KEY=A_GENERER
# Durée d'une session avant renouvellement automatique (secondes).
JWT_EXPIRY=3600
